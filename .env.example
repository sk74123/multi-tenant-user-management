# Server
APP_PORT=8080
APP_ENV=development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=mtums
DB_PASSWORD=mtums_secret
DB_NAME=mtums_db
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-must-be-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-must-be-32-chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Bcrypt
BCRYPT_COST=12

